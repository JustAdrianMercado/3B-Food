{
  "name": "ecorescate-cochabamba",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.1"
  },
  "description": "EcoRescate Cochabamba: excedentes alimentarios de restaurantes y supermercados a un mejor precio.",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/domain.test.ts",
    "test:db": "node --env-file=.env.local --import tsx --test tests/db.test.ts",
    "test:e2e": "playwright test",
    "db:migrate": "node --env-file=.env.local --import tsx scripts/db-migrate.ts",
    "db:seed": "node --env-file=.env.local --import tsx scripts/db-seed.ts",
    "assets": "node scripts/fetch-assets.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/dm-serif-display": "5.3.0",
    "@supabase/supabase-js": "2.119.0",
    "clsx": "2.1.1",
    "lucide-react": "1.70.0",
    "motion": "14.10.1",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "pg": "8.23.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
